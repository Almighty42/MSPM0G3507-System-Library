{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "MSPM0G3507: XDS110/OpenOCD",
            "type": "cortex-debug",
            "request": "launch",
            "cwd": "${workspaceFolder}",
            "executable": "${command:cmake.launchTargetPath}",
            "servertype": "openocd",
            "configFiles": [
                "interface/cmsis-dap.cfg",
                "board/ti_mspm0_launchpad.cfg"
